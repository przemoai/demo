# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself
# for the two API replicas — see docker-compose.yml.

# Redis is the shared source of truth for cart state and the pub/sub bus
# used to broadcast cart change events between replicas.
REDIS_URL=redis://localhost:6379/0

# MongoDB is the persistent store for orders.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=cart_poc

# Identifies which replica handled a request, for logs and the
# X-Replica-Id response header. Give each replica a distinct value.
REPLICA_ID=local-dev

LOG_LEVEL=INFO
